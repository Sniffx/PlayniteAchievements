     internal sealed class InGameAchievementMonitor : IDisposable
     {
         private const int StartupDelaySeconds = 20;
+        // A game with no resolvable provider at launch (for example a Local game whose achievement file
+        // is only created during its first run) keeps retrying the normal provider resolution while it runs.
+        private static readonly TimeSpan ActivationRetryInterval = TimeSpan.FromSeconds(15);
         private static readonly TimeSpan SchedulerResolution = TimeSpan.FromMilliseconds(100);
         private static readonly TimeSpan FileDebounce = TimeSpan.FromMilliseconds(150);
         private static readonly TimeSpan ConfiguredLogInterval = TimeSpan.FromMinutes(5);
@@ -277,8 +280,52 @@ await _refreshRuntime
                 return;
             }
 
-            Stop(game);
-            _logger?.Info($"[InGameMonitor] Skipped: no authenticated provider for '{game.Name}'.");
+            // Nothing resolves yet. The achievement file may only appear while the game is running,
+            // so keep watching for the rest of the session. Stop(game) cancels the session token.
+            _logger?.Info($"[InGameMonitor] No provider for '{game.Name}' yet; will keep checking while the game is running.");
+            while (true)
+            {
+                try
+                {
+                    await Task.Delay(ActivationRetryInterval, state.SessionToken).ConfigureAwait(false);
+                }
+                catch (OperationCanceledException)
+                {
+                    return;
+                }
+
+                lock (_stateLock)
+                {
+                    if (!_games.TryGetValue(game.Id, out var currentState) ||
+                        !ReferenceEquals(state, currentState))
+                    {
+                        return;
+                    }
+                }
+
+                var activated = false;
+                try
+                {
+                    activated = TryActivate(state);
+                }
+                catch (Exception ex)
+                {
+                    _logger?.Debug(ex, $"[InGameMonitor] Activation check failed for {game.Name}.");
+                }
+
+                if (activated)
+                {
+                    lock (_stateLock)
+                    {
+                        var now = CaptureTimelineClock.UtcNow;
+                        state.NextFallbackDueUtc = now.AddSeconds(StartupDelaySeconds);
+                        state.NextFriendDueUtc = now.AddSeconds(StartupDelaySeconds).Add(GetFriendInterval());
+                    }
+
+                    _logger?.Info($"[InGameMonitor] Provider became available for '{game.Name}' during the session.");
+                    return;
+                }
+            }
         }
 
         public void Stop(Game game)
